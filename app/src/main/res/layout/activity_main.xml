<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 全屏相机预览 -->
    <TextureView
        android:id="@+id/camera_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 2. 权限请求提示 (未授权时居中显示) -->
    <LinearLayout
        android:id="@+id/layout_permission_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_camera_permission_required"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_request_permission" />
    </LinearLayout>

    <!-- 3. 左上角轻量 HUD 浮层 (可点击折叠/展开) -->
    <LinearLayout
        android:id="@+id/layout_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="#B31A2328"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_hud_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_title"
            android:textColor="#80D8FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="2dp"
            android:text="状态: 正在初始化..."
            android:textColor="#ECEFF1"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 4. 右上角浮动“⚙ 设置”按钮 -->
    <Button
        android:id="@+id/btn_open_drawer"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#CC263238"
        android:minWidth="80dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/btn_open_settings"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- 5. 抽屉半透明背景遮罩 (点击可收起抽屉) -->
    <View
        android:id="@+id/view_drawer_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:visibility="gone" />

    <!-- 6. 右侧滑出设置抽屉面板 -->
    <LinearLayout
        android:id="@+id/layout_drawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F5F7F8"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 抽屉头部标题与关闭按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#263238"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_camera"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_drawer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="#37474F"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_close_drawer"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 抽屉滚动内容区域 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 变换模式选择 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_mode"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_mode_matrix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/mode_matrix"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_mode_view_scale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_view_scale"
                        android:textSize="12sp" />
                </RadioGroup>

                <!-- 旋转控制 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_rotation"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_rot_0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/rot_0"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_rot_90"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:text="@string/rot_90"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_rot_180"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:text="@string/rot_180"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_rot_270"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:text="@string/rot_270"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 镜像控制 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_mirror"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cb_mirror_h"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mirror_h"
                        android:textSize="11sp" />

                    <CheckBox
                        android:id="@+id/cb_mirror_v"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mirror_v"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 摄像头与快捷操作 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_camera_device"
                    android:textColor="#263238"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_switch_camera"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="@string/btn_switch_camera"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_reset"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_reset"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>



